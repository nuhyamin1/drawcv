include LICENSE
include README.md
include RELEASE_NOTES.md
include pyproject.toml

recursive-include drawcv *.py
recursive-include tests *.py *.svg *.ttf *.otf *.json
recursive-include docs *.md
recursive-include examples *.py *.txt

exclude *.png
exclude *.mp4
prune examples/output
prune benchmarks/results
prune scratch
